{
  "name": "chrome-extension",
  "version": "1.0.0",
  "description": "Complete tab management in one extension: organize by domain AND remove duplicates with one click each.",
  "main": "background.js",
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "verbose": true,
    "collectCoverageFrom": [
      "**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageReporters": ["text", "text-summary", "lcov", "html", "json-summary"]
  },
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
