{
  "name": "chrome-extension",
  "version": "1.0.0",
  "description": "Complete tab management in one extension: organize by domain AND remove duplicates with one click each.",
  "main": "background.js",
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:unit": "jest --testPathIgnorePatterns=e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "background.js",
      "popup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "html",
      "json-summary"
    ]
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "puppeteer": "^24.30.0"
  }
}
